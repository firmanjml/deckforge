{
  "name": "deckforge",
  "version": "0.1.1",
  "description": "DeckForge — a native Decky Loader trainer platform (cockpit + relay + forge).",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "forge:build": "cargo build --release --manifest-path forge/Cargo.toml",
    "forge:test": "cargo test --manifest-path forge/Cargo.toml",
    "build:all": "npm run forge:build && npm run build"
  },
  "keywords": ["decky", "plugin", "trainer", "steam-deck", "deckforge"],
  "author": "DeckForge",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "rollup": "^4.18.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["react", "react-dom"]
    }
  }
}
